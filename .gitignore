# Python
__pycache__/
*.py[cod]
*.egg-info/
*.so
.venv
.env
.python-version

# Test / coverage / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging output / downloaded dumps
dist/
downloads/

# Editors and OS
.idea
.vscode
.DS_Store
.unison*
*.kgrind
*.pyprof

**/_version.py

# Rust
/target
# gitignored build artifact (rebuilt deterministically from the pinned dump)
/crates/ultravin/data/*
!/crates/ultravin/data/.gitkeep
!/crates/ultravin/data/manifest.json

# Detached campaign runtime (state, logs, fail-logs, coverage)
/campaign/

# Claude Code session state (local permissions, locks, saved workflows)
/.claude/

# Agent patch bundles downloaded into the checkout by the fix-publish jobs — CI
# `git add -A`s after applying them, which would otherwise commit the artifact
/fix-bundle/
/fix/
