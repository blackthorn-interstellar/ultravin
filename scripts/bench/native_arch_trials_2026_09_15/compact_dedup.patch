+fn candidate_cmp(
+    db: &Db,
+    patterns: &[(i32, u32)],
+    schema_yearfrom: &IntMap<i32, i32>,
+    items: &[DecodingItem],
+    a: usize,
+    b: usize,
+) -> Ordering {
+    let pattern_count = patterns.len();
+    let numeric = |index: usize| {
+        if index < pattern_count {
+            let p = &db.patterns()[patterns[index].1 as usize];
+            (
+                *schema_yearfrom
+                    .get(&p.vinschemaid.to_native())
+                    .unwrap_or(&0),
+                p.createdon_key.to_native(),
+            )
+        } else {
+            let item = &items[index - pattern_count];
+            (item.priority, item.created_on)
+        }
+    };
+    let keys = |index: usize| {
+        if index < pattern_count {
+            (
+                db.s(db.patterns()[patterns[index].1 as usize].keys.to_native()),
+                true,
+            )
+        } else {
+            (items[index - pattern_count].keys.as_ref(), false)
+        }
+    };
+    let (ap, ac) = numeric(a);
+    let (bp, bc) = numeric(b);
+    let (ak, normalize_a) = keys(a);
+    let (bk, normalize_b) = keys(b);
+    rank_cmp(ap, ac, ak, normalize_a, a, bp, bc, bk, normalize_b, b)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn rank_cmp(
+    ap: i32,
+    ac: i64,
+    ak: &str,
+    normalize_a: bool,
+    ai: usize,
+    bp: i32,
+    bc: i64,
+    bk: &str,
+    normalize_b: bool,
+    bi: usize,
+) -> Ordering {
+    bp.cmp(&ap)
+        .then_with(|| created_desc_nulls_first(ac, bc))
+        .then_with(|| len_no_star(ak).cmp(&len_no_star(bk)))
+        .then_with(|| cmp_rank_keys(ak, normalize_a, bk, normalize_b))
         .then_with(|| ai.cmp(&bi))
 }
 
+/// Compare the stored key representation used by dedup. Compact Pattern keys
+/// apply `uppercase_key` bytewise without allocating; expanded keys already
+/// carry their final spelling.
+fn cmp_rank_keys(a: &str, normalize_a: bool, b: &str, normalize_b: bool) -> Ordering {
+    let mut ai = a.bytes().filter_map(|byte| {
+        if matches!(byte, b'[' | b']') {
+            None
+        } else if normalize_a {
+            Some(byte.to_ascii_uppercase())
+        } else {
+            Some(byte)
+        }
+    });
+    let mut bi = b.bytes().filter_map(|byte| {
+        if matches!(byte, b'[' | b']') {
+            None
+        } else if normalize_b {
+            Some(byte.to_ascii_uppercase())
+        } else {
+            Some(byte)
+        }
+    });
+    loop {
+        match (ai.next(), bi.next()) {
+            (Some(x), Some(y)) => match x.cmp(&y) {
+                Ordering::Equal => continue,
+                other => return other,
+            },
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+        }
+    }
+}
