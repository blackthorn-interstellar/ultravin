+/// Compare the stored key representation used by dedup. Compact Pattern keys
+/// apply `uppercase_key` bytewise without allocating; expanded keys already
+/// carry their final spelling.
+fn cmp_rank_keys(a: &str, normalize_a: bool, b: &str, normalize_b: bool) -> Ordering {
+    let mut ai = a.bytes().filter_map(|byte| {
+        if matches!(byte, b'[' | b']') {
+            None
+        } else if normalize_a {
+            Some(byte.to_ascii_uppercase())
+        } else {
+            Some(byte)
+        }
+    });
+    let mut bi = b.bytes().filter_map(|byte| {
+        if matches!(byte, b'[' | b']') {
+            None
+        } else if normalize_b {
+            Some(byte.to_ascii_uppercase())
+        } else {
+            Some(byte)
+        }
+    });
+    loop {
+        match (ai.next(), bi.next()) {
+            (Some(x), Some(y)) => match x.cmp(&y) {
+                Ordering::Equal => continue,
+                other => return other,
+            },
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
