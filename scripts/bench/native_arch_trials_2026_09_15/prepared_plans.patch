+    fn wmi_row_position(&self, wmi: &ArchivedWmi) -> usize {
+        let rows = self.wmis();
+        let base = rows.as_ptr() as usize;
+        let address = std::ptr::from_ref(wmi) as usize;
+        debug_assert!(address >= base);
+        debug_assert!(address < base + std::mem::size_of_val(rows));
+        debug_assert_eq!((address - base) % std::mem::size_of::<ArchivedWmi>(), 0);
+        (address - base) / std::mem::size_of::<ArchivedWmi>()
+    }
+
+    /// Reusable schema setup for the exact WMI row selected by publication time.
+    /// `None` has its own all-links plan; real years use only the finite intervals
+    /// induced by this WMI's link bounds.
+    pub(crate) fn prepared_decode_plan<'a>(
+        &'a self,
+        wmi: &ArchivedWmi,
+        model_year: Option<i32>,
+    ) -> PreparedPlanLookup<'a> {
+        let slots = self
+            .decode_plans
+            .get_or_init(|| (0..self.wmis().len()).map(|_| OnceLock::new()).collect());
+        let plans = slots[self.wmi_row_position(wmi)]
+            .get_or_init(|| self.build_prepared_wmi_plans(wmi.id.to_native()));
+        let PreparedWmiPlans::Cached {
+            any_year,
+            empty,
+            intervals,
+        } = plans
+        else {
+            return PreparedPlanLookup::Reference;
+        };
+        let Some(year) = model_year else {
+            return PreparedPlanLookup::Cached(any_year);
+        };
+        let index = intervals.partition_point(|interval| interval.last < year);
+        let plan = intervals
+            .get(index)
+            .filter(|interval| interval.first <= year)
+            .map_or(empty, |interval| &interval.plan);
+        PreparedPlanLookup::Cached(plan)
+    }
+
+    fn build_prepared_wmi_plans(&self, wmi_id: i32) -> PreparedWmiPlans {
+        let links = self.wmi_vinschema_for(wmi_id);
+        let mut remaining = MAX_PREPARED_DECODE_PLAN_ENTRIES;
+        let Some(any_year) = self.compose_prepared_decode_plan(links, None, &mut remaining) else {
+            return PreparedWmiPlans::Reference;
+        };
+
+        // i64 admits the half-open endpoint after i32::MAX without overflow.
+        let mut boundaries = Vec::with_capacity(links.len().saturating_mul(2));
+        for link in links {
+            let first = link.yearfrom.to_native();
+            let last = link.yearto_or(2999);
+            if first <= last {
+                boundaries.push(i64::from(first));
+                boundaries.push(i64::from(last) + 1);
+            }
+        }
+        boundaries.sort_unstable();
+        boundaries.dedup();
+
+        let mut intervals: Vec<PreparedYearInterval> = Vec::new();
+        for bounds in boundaries.windows(2) {
+            let first = i32::try_from(bounds[0]).expect("link start is an i32");
+            let last = i32::try_from(bounds[1] - 1).expect("inclusive link end is an i32");
+            let Some(plan) = self.compose_prepared_decode_plan(links, Some(first), &mut remaining)
+            else {
+                return PreparedWmiPlans::Reference;
+            };
+            if plan.regular_schemas.is_empty() && plan.formula_schemas.is_empty() {
+                continue;
+            }
+            if let Some(previous) = intervals.last_mut() {
+                if previous.last.checked_add(1) == Some(first) && previous.plan == plan {
+                    previous.last = last;
+                    remaining += plan.regular_schemas.len() + plan.formula_schemas.len();
+                    continue;
+                }
+            }
+            intervals.push(PreparedYearInterval { first, last, plan });
+        }
+        PreparedWmiPlans::Cached {
+            any_year,
+            empty: PreparedDecodePlan {
+                regular_schemas: Box::new([]),
+                formula_schemas: Box::new([]),
+            },
+            intervals: intervals.into_boxed_slice(),
+        }
+    }
+
+    fn compose_prepared_decode_plan(
+        &self,
+        links: &[ArchivedWmiVinSchema],
+        model_year: Option<i32>,
+        remaining: &mut usize,
+    ) -> Option<PreparedDecodePlan> {
+        let eligible = |link: &ArchivedWmiVinSchema| {
+            model_year.is_none_or(|year| {
+                year >= link.yearfrom.to_native() && year <= link.yearto_or(2999)
+            })
+        };
+
+        // This map is intentionally populated before the VinSchema/QC gate. The
+        // SQL temp-table conflict behavior chooses the first eligible link even
+        // when that schema cannot produce a regular-pattern visit.
+        let mut first_year_from = IntMap::default();
+        for link in links.iter().filter(|link| eligible(link)) {
+            first_year_from
+                .entry(link.vinschemaid.to_native())
+                .or_insert(link.yearfrom.to_native());
+        }
+
+        let mut regular_schemas = Vec::new();
+        for link in links.iter().filter(|link| eligible(link)) {
+            let schema_id = link.vinschemaid.to_native();
+            if self
+                .vinschema_by_id(schema_id)
+                .is_none_or(|schema| schema.tobeqced)
+            {
+                continue;
+            }
+            *remaining = remaining.checked_sub(1)?;
+            regular_schemas.push(PreparedRegularSchema {
+                schema_id,
+                priority: first_year_from[&schema_id],
+            });
+        }
+
+        let mut formula_schemas = Vec::new();
+        let mut seen = IntSet::default();
+        for link in links.iter().filter(|link| eligible(link)) {
+            let schema_id = link.vinschemaid.to_native();
+            if !seen.insert(schema_id) {
+                continue;
+            }
+            *remaining = remaining.checked_sub(1)?;
+            formula_schemas.push(schema_id);
+        }
+        Some(PreparedDecodePlan {
+            regular_schemas: regular_schemas.into_boxed_slice(),
+            formula_schemas: formula_schemas.into_boxed_slice(),
+        })
+    }
+
