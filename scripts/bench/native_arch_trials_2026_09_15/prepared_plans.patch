+    #[test]
+    fn prepared_decode_plans_preserve_boundaries_duplicates_and_branch_gates() {
+        let db = load_fixture(&prepared_plan_fixture());
+        let wmi = db.wmi_by_str("ABC", 100).expect("first row is public");
+
+        let plan = cached_plan(&db, wmi, Some(2004));
+        assert_eq!(
+            plan.regular_schemas.as_ref(),
+            [
+                PreparedRegularSchema {
+                    schema_id: 10,
+                    priority: 2000,
+                },
+                PreparedRegularSchema {
+                    schema_id: 10,
+                    priority: 2000,
+                },
+            ]
+        );
+        assert_eq!(plan.formula_schemas.as_ref(), [10, 30, 40]);
+
+        let boundary = cached_plan(&db, wmi, Some(2005));
+        assert_eq!(boundary.regular_schemas.len(), 2);
+        let next = cached_plan(&db, wmi, Some(2006));
+        assert_eq!(
+            next.regular_schemas.as_ref(),
+            [
+                PreparedRegularSchema {
+                    schema_id: 10,
+                    priority: 2003,
+                },
+                PreparedRegularSchema {
+                    schema_id: 20,
+                    priority: 2006,
+                },
+            ]
+        );
+        assert_eq!(next.formula_schemas.as_ref(), [10, 20]);
+
+        let all = cached_plan(&db, wmi, None);
+        assert_eq!(
+            all.regular_schemas
+                .iter()
+                .map(|schema| (schema.schema_id, schema.priority))
+                .collect::<Vec<_>>(),
+            [
+                (10, 2000),
+                (10, 2000),
+                (20, 2006),
+                (10, 2000),
+                (20, 2006),
+                (20, 2006),
+            ]
+        );
+        assert_eq!(all.formula_schemas.as_ref(), [10, 20, 30, 40]);
+        for year in [1999, 3000, 3999] {
+            let empty = cached_plan(&db, wmi, Some(year));
+            assert!(empty.regular_schemas.is_empty(), "year {year}");
+            assert!(empty.formula_schemas.is_empty(), "year {year}");
+        }
+
+        for year in [i32::MIN, -100] {
+            let low = cached_plan(&db, wmi, Some(year));
+            assert_eq!(
+                low.regular_schemas.as_ref(),
+                [PreparedRegularSchema {
+                    schema_id: 20,
+                    priority: i32::MIN,
+                }]
+            );
+            assert_eq!(low.formula_schemas.as_ref(), [20]);
+        }
+        assert!(cached_plan(&db, wmi, Some(-99)).regular_schemas.is_empty());
+        for year in [4000, i32::MAX] {
+            let high = cached_plan(&db, wmi, Some(year));
+            assert_eq!(
+                high.regular_schemas.as_ref(),
+                [PreparedRegularSchema {
+                    schema_id: 20,
+                    priority: 4000,
+                }]
+            );
+            assert_eq!(high.formula_schemas.as_ref(), [20]);
+        }
+    }
