+/// One regular-pattern schema visit prepared for a decode pass. Duplicate
+/// WMI/schema links remain duplicate visits; `priority` is the first eligible
+/// link's YearFrom for this schema, matching the core's INSERT/ON-CONFLICT setup.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct PreparedRegularSchema {
+    pub schema_id: i32,
+    pub priority: i32,
+}
+
+/// The two deliberately different schema views used by one decode pass.
+/// Regular matching requires a non-QC VinSchema and preserves duplicate links;
+/// formula matching permits QC/orphan schemas and visits each schema once.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct PreparedDecodePlan {
+    pub regular_schemas: Box<[PreparedRegularSchema]>,
+    pub formula_schemas: Box<[i32]>,
+}
+
+#[derive(Debug)]
+struct PreparedYearInterval {
+    first: i32,
+    last: i32,
+    plan: PreparedDecodePlan,
+}
+
+#[derive(Debug)]
+enum PreparedWmiPlans {
+    Cached {
+        any_year: PreparedDecodePlan,
+        empty: PreparedDecodePlan,
+        intervals: Box<[PreparedYearInterval]>,
+    },
+    /// A pathological custom artifact can make interval count x eligible links
+    /// quadratic. Preserve exact behavior through the reference loops instead of
+    /// retaining an oversized per-WMI expansion.
+    Reference,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum PreparedPlanLookup<'a> {
+    Cached(&'a PreparedDecodePlan),
+    Reference,
+}
+
