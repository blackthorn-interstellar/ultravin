+    #[test]
+    fn conversions_select_stably_from_original_owned_items_and_keep_provenance() {
+        let db = conversion_test_db();
+        let mut items = vec![
+            conversion_source_item(10, "7", "older", 100, 1),
+            conversion_source_item(11, "5", "null-wins", NULL_I64, 2),
+            conversion_source_item(12, "6", "stable", 50, 3),
+            conversion_source_item(13, "9", "blocked", 50, 4),
+            conversion_source_item(50, "existing", "existing", 0, 5),
+        ];
+
+        append_conversions(&db, &mut items);
