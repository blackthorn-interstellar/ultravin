+/// Whether each deferred correction would have a nonempty value. This is the
+/// only property of correction values consulted by best-pass scoring.
+fn correction_presence(db: &Db, err: &errors::ErrorState, descriptor: &str) -> [(i32, bool); 6] {
+    [
+        (142, !err.corrected_vin.is_empty()),
+        (143, !err.codes.is_empty()),
+        (144, !err.error_bytes.is_empty()),
+        (156, !err.additional_info.is_empty()),
+        (191, error_messages_nonempty(db, err)),
+        (196, !descriptor.is_empty()),
+    ]
+}
+
+/// `error_messages` joins every successful lookup, including blank names. Two
+/// blank names therefore still produce the nonempty separator `; `.
+fn error_messages_nonempty(db: &Db, err: &errors::ErrorState) -> bool {
+    let Some(tag) = tables::element_lookup_tag(143) else {
+        return false;
+    };
+    joined_error_parts_nonempty(err.codes.iter().filter_map(|&code| {
+        db.lookup(tag, code).map(|name| {
+            (
+                name,
+                (err.is_off_road && code == 1) || (err.is_vin_exception && code == 0),
+            )
+        })
+    }))
+}
+
+fn joined_error_parts_nonempty<'a>(parts: impl IntoIterator<Item = (&'a str, bool)>) -> bool {
+    let mut emitted = false;
+    for (name, has_note) in parts {
+        if emitted || !name.trim().is_empty() || has_note {
+            return true;
+        }
+        emitted = true;
+    }
+    false
+}
